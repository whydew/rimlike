<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Weather modifiers =====================
    Each node rolls one; the node drives its intensity up over time with no cap.
  -->
  <GameConditionDef>
    <defName>Roguelike_EscalatingCold</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingTemperature</conditionClass>
    <label>deepening cold</label>
    <description>An unnatural cold has settled over this region. Once it starts, it gets worse every day until you leave.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>-1.4</ratePerDay><graceDays>4</graceDays><tileTemperature>-100~18</tileTemperature></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_EscalatingHeat</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingTemperature</conditionClass>
    <label>rising heat</label>
    <description>An unnatural heat has settled over this region. Once it starts, it gets worse every day until you leave.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>1.4</ratePerDay><graceDays>4</graceDays><tileTemperature>12~100</tileTemperature></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_EscalatingToxic</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingToxic</conditionClass>
    <label>creeping toxins</label>
    <description>Toxic particles drift down and build up in anyone outdoors. Once it is strong enough it seeps indoors too.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>0.012</ratePerDay><graceDays>5</graceDays></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_EscalatingPsychic</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingPsychic</conditionClass>
    <label>rising psychic drone</label>
    <description>A psychic drone that grows stronger every day, souring everyone's mood until minds start to break.</description>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>0.13</ratePerDay><graceDays>4</graceDays></li></modExtensions>
  </GameConditionDef>

  <ThoughtDef>
    <defName>Roguelike_PsychicDrone</defName>
    <workerClass>Roguelike.ThoughtWorker_RoguelikePsychic</workerClass>
    <effectMultiplyingStat>PsychicSensitivity</effectMultiplyingStat>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li><label>psychic drone (low)</label><description>A low psychic drone is pressing on my mind.</description><baseMoodEffect>-8</baseMoodEffect></li>
      <li><label>psychic drone (medium)</label><description>A psychic drone is grinding on my mind.</description><baseMoodEffect>-16</baseMoodEffect></li>
      <li><label>psychic drone (high)</label><description>A strong psychic drone is crushing my thoughts.</description><baseMoodEffect>-28</baseMoodEffect></li>
      <li><label>psychic drone (extreme)</label><description>An extreme psychic drone is tearing my mind apart.</description><baseMoodEffect>-45</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <!-- World object that owns a node map. The map is removed once no colonists remain. -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>Roguelike_Node</defName>
    <label>node</label>
    <description>A roguelike node.</description>
    <worldObjectClass>Roguelike.RoguelikeNode</worldObjectClass>
    <texture>World/WorldObjects/Camp</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Camp</expandingIconTexture>
    <expandingIconPriority>80</expandingIconPriority>
    <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
  </WorldObjectDef>

  <!-- Act-graph node marker. Bottom-row nodes are the landing choices. -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>Roguelike_RunNode</defName>
    <label>run node</label>
    <description>A node of the current act. Land on a bottom-row node to start, then travel along the lines to reach the boss.</description>
    <worldObjectClass>Roguelike.RunNodeMarker</worldObjectClass>
    <texture>World/WorldObjects/JourneyDestination</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/JourneyDestination</expandingIconTexture>
    <expandingIconPriority>90</expandingIconPriority>
    <expandMore>true</expandMore>
    <!-- Must stay true: vanilla refuses to land on tiles holding objects that cannot have a map. -->
    <canHaveMap>true</canHaveMap>
  </WorldObjectDef>

  <LetterDef ParentName="PositiveEvent">
    <defName>Roguelike_NodeComplete</defName>
    <letterClass>Roguelike.Letter_NodeComplete</letterClass>
  </LetterDef>

  <!-- Run scenario: Crashlanded, but you land on a chosen starting node. -->
  <ScenPartDef>
    <defName>Roguelike_Run</defName>
    <label>roguelike run</label>
    <category>Fixed</category>
    <scenPartClass>Roguelike.ScenPart_RoguelikeRun</scenPartClass>
    <summaryPriority>900</summaryPriority>
  </ScenPartDef>

  <ScenarioDef ParentName="Crashlanded">
    <defName>Roguelike_RunScenario</defName>
    <label>Roguelike: Crashlanded</label>
    <description>Three survivors crashland on a starting node of their choosing. Complete each node's objective before its weather turns deadly.</description>
    <scenario>
      <summary>Prototype roguelike run: choose a starting node on the world map.</summary>
      <parts>
        <li Class="Roguelike.ScenPart_RoguelikeRun">
          <def>Roguelike_Run</def>
          <starterId>crashlanded</starterId>
          <starterRelic>Roguelike_Relic_BlackBox</starterRelic>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <!-- ===================== Node presets =====================
    Tune by feel; no recompile needed.
    kind:            Expedition, CombatAlerted, CombatUnaware, Escort, Event. Row 0 is always Expedition.
    objective:       Stockpile (quota), Build (buildTarget), Survive (surviveDays), KillAll, Escort (surviveDays).
    condition:       weather modifier (omit for none). offsetPerDay is its rate: °C for temperature,
                     toxic buildup per day for toxic, drone levels per day for psychic.
    graceDays, targetDays, paceSensitivity, minPaceFactor, maxPaceFactor: the pace-driven clock.
    tileTemperature: world-tile average temperatures (°C) the preset fits.
    threatScale, patrolIntervalDays, reinforcementDays: enemy pressure (patrols on an expedition pick a raiding faction).
    weight:          relative chance among presets of the same kind.
    requirements:    (objective Requirements) each may add minImpressiveness (rooms: 40 decent, 50 slightly, 65 somewhat
                     impressive) and holdDays (met for that many days in total; the clock pauses, not resets, when it isn't).
    ensureMineable:  e.g. <Steel>900</Steel>: the node map gets enough ore to mine that much.
  -->

  <!-- Expeditions: classic base building. Each takes roughly 25-45 in-game days (see docs/research/rimworld-early-game-pacing.md):
       a list of requirements (counts marked perColonist scale with the squad on arrival) plus a minimum stay,
       under a weather modifier rolled per node to fit the climate (rates live on the modifiers' ModifierExtension). -->
  <Roguelike.NodePresetDef Name="Roguelike_BaseExpedition" Abstract="True">
    <objective>Requirements</objective>
    <randomModifier>true</randomModifier>
    <minDays>25</minDays>
    <targetDays>30</targetDays>
    <paceSensitivity>1.5</paceSensitivity>
    <minPaceFactor>0.5</minPaceFactor>
    <maxPaceFactor>1.6</maxPaceFactor>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_GreatGranary</defName>
    <growingTwelfths>7</growingTwelfths>
    <label>great granary</label>
    <description>Fertile ground, a long season. Grow a granary's worth of corn and keep the squad fed and housed.</description>
    <requirements>
      <li><kind>Produce</kind><thing>RawCorn</thing><count>1500</count></li>
      <li><kind>Keep</kind><thing>MealSimple</thing><count>20</count><perColonist>true</perColonist></li>
      <li><kind>Shelter</kind><count>1</count><perColonist>true</perColonist></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_HarvestRotation</defName>
    <growingTwelfths>7</growingTwelfths>
    <label>harvest rotation</label>
    <description>Work the fields through a full rotation of rice, potatoes and corn.</description>
    <requirements>
      <li><kind>Produce</kind><thing>RawRice</thing><count>600</count></li>
      <li><kind>Produce</kind><thing>RawPotatoes</thing><count>600</count></li>
      <li><kind>Produce</kind><thing>RawCorn</thing><count>600</count></li>
      <li><kind>Shelter</kind><count>1</count><perColonist>true</perColonist></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_RiceCooperative</defName>
    <growingTwelfths>5</growingTwelfths>
    <label>rice cooperative</label>
    <description>Paddies by the water. Bring in a great rice harvest and give everyone a room of their own.</description>
    <requirements>
      <li><kind>Produce</kind><thing>RawRice</thing><count>1800</count></li>
      <li><kind>Bedrooms</kind><count>1</count><perColonist>true</perColonist><minCells>12</minCells></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_MedicinalGarden</defName>
    <growingTwelfths>7</growingTwelfths>
    <requiresSkill>Plants</requiresSkill>
    <requiresSkillLevel>8</requiresSkillLevel>
    <label>medicinal garden</label>
    <description>Healroot grows wild here. Cultivate a medicine stock and keep everyone housed.</description>
    <requirements>
      <li><kind>Produce</kind><thing>MedicineHerbal</thing><count>60</count></li>
      <li><kind>Shelter</kind><count>1</count><perColonist>true</perColonist></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_StoneFortress</defName>
    <label>stone fortress</label>
    <description>Rocky ground, long nights and raiders who probe the walls. Cut stone, raise a real fortress and hold it.</description>
    <patrolIntervalDays>5</patrolIntervalDays>
    <requirements>
      <li><kind>Build</kind><thing>Wall</thing><count>300</count><stuffCategory>Stony</stuffCategory><holdDays>10</holdDays></li>
      <li><kind>Build</kind><thing>Door</thing><count>12</count></li>
      <li><kind>Shelter</kind><count>1</count><perColonist>true</perColonist></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_PrivateQuarters</defName>
    <label>private quarters</label>
    <description>Settle in properly: a fine bedroom for everyone and a dining room worth gathering in.</description>
    <requirements>
      <li><kind>Bedrooms</kind><count>1</count><perColonist>true</perColonist><minCells>12</minCells><minImpressiveness>50</minImpressiveness></li>
      <li><kind>DiningRoom</kind><minCells>25</minCells><minImpressiveness>65</minImpressiveness></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef ParentName="Roguelike_BaseExpedition">
    <defName>Roguelike_SeasonalEndurance</defName>
    <label>seasonal endurance</label>
    <description>Hold this ground for a full season. Nobody can be lost.</description>
    <minDays>30</minDays>
    <requirements>
      <li><kind>NoDeaths</kind></li>
      <li><kind>Keep</kind><thing>MealSimple</thing><count>10</count><perColonist>true</perColonist></li>
      <li><kind>Shelter</kind><count>1</count><perColonist>true</perColonist></li>
    </requirements>
  </Roguelike.NodePresetDef>

  <!-- Combat -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_Ambush</defName>
    <label>ambush</label>
    <description>Raiders were waiting for you.</description>
    <kind>CombatAlerted</kind>
    <objective>KillAll</objective>
    <targetDays>2</targetDays>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef>
    <defName>Roguelike_RaiderCamp</defName>
    <label>raider camp</label>
    <description>A raider camp lies across the valley. They haven't seen you yet.</description>
    <kind>CombatUnaware</kind>
    <objective>KillAll</objective>
    <condition>Roguelike_EscalatingToxic</condition>
    <offsetPerDay>0.05</offsetPerDay>
    <targetDays>5</targetDays>
    <patrolIntervalDays>2</patrolIntervalDays>
    <reinforcementDays>5</reinforcementDays>
  </Roguelike.NodePresetDef>

  <!-- Escort -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_RefugeeEscort</defName>
    <label>refugee escort</label>
    <description>A refugee begs for protection until their people arrive.</description>
    <kind>Escort</kind>
    <objective>Escort</objective>
    <surviveDays>4</surviveDays>
    <targetDays>4</targetDays>
    <threatScale>0.8</threatScale>
    <patrolIntervalDays>1.5</patrolIntervalDays>
  </Roguelike.NodePresetDef>

  <!-- Event -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_Encounter</defName>
    <label>strange encounter</label>
    <description>Something waits on the road ahead.</description>
    <kind>Event</kind>
  </Roguelike.NodePresetDef>

  <!-- Elite: a tougher raid; the reward is a choice of relics. -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_EliteWarband</defName>
    <label>warband stronghold</label>
    <description>A veteran warband holds a fortified base here. Storm it for a choice of relics.</description>
    <kind>Elite</kind>
    <assault>true</assault>
    <objective>KillAll</objective>
    <targetDays>2</targetDays>
    <threatScale>1.8</threatScale>
  </Roguelike.NodePresetDef>

  <!-- Map-less service nodes. -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_RestSite</defName>
    <label>rest site</label>
    <description>A sheltered spot to catch your breath.</description>
    <kind>Rest</kind>
    <eventDef>Roguelike_Event_RestSite</eventDef>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef>
    <defName>Roguelike_Merchant</defName>
    <label>merchant</label>
    <description>A travelling trader. Pay with the silver your caravan carries.</description>
    <kind>Merchant</kind>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef>
    <defName>Roguelike_Treasure</defName>
    <label>treasure</label>
    <description>Something valuable is hidden here.</description>
    <kind>Treasure</kind>
    <eventDef>Roguelike_Event_Treasure</eventDef>
  </Roguelike.NodePresetDef>

  <!-- Bosses: a large raid under brutal weather. -->
  <Roguelike.NodePresetDef>
    <defName>Roguelike_BossCold</defName>
    <label>frozen warlord</label>
    <description>Storm the frozen warlord's stronghold. The cold is on his side, and his reinforcements are coming.</description>
    <kind>CombatAlerted</kind>
    <objective>KillAll</objective>
    <isBoss>true</isBoss>
    <assault>true</assault>
    <reinforcementDays>1.5</reinforcementDays>
    <condition>Roguelike_EscalatingCold</condition>
    <graceDays>1</graceDays>
    <offsetPerDay>-6</offsetPerDay>
    <targetDays>3</targetDays>
    <threatScale>3</threatScale>
    <tileTemperature>-100~18</tileTemperature>
  </Roguelike.NodePresetDef>

  <Roguelike.NodePresetDef>
    <defName>Roguelike_BossHeat</defName>
    <label>scorched warlord</label>
    <description>Storm the scorched warlord's stronghold. The heat is on his side, and his reinforcements are coming.</description>
    <kind>CombatAlerted</kind>
    <objective>KillAll</objective>
    <isBoss>true</isBoss>
    <assault>true</assault>
    <reinforcementDays>1.5</reinforcementDays>
    <condition>Roguelike_EscalatingHeat</condition>
    <graceDays>1</graceDays>
    <offsetPerDay>6</offsetPerDay>
    <targetDays>3</targetDays>
    <threatScale>3</threatScale>
    <tileTemperature>12~100</tileTemperature>
  </Roguelike.NodePresetDef>

  <!-- ===================== Events ===================== -->
  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_RestSite</defName>
    <label>rest site</label>
    <pooled>false</pooled>
    <text>A sheltered hollow, out of the wind. There is time for one thing before you move on.</text>
    <options>
      <li><label>Rest</label><result>Everyone sleeps soundly for once.</result><outcomes><li><kind>HealAll</kind></li></outcomes></li>
      <li><label>Train</label><result>You drill until dark.</result><outcomes><li><kind>TrainSkills</kind><amount>4000</amount></li></outcomes></li>
      <li><label>Field surgery</label><result>With steady hands and a clean knife, you treat the worst of your wounds.</result><outcomes><li><kind>FixWorst</kind></li></outcomes></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_Treasure</defName>
    <label>sealed vault</label>
    <pooled>false</pooled>
    <text>An old vault, half-buried. Its lock is rusted; its inner door is trapped.</text>
    <options>
      <li><label>Take what's in the antechamber</label><result>You find a relic waiting in the dust.</result><outcomes><li><kind>RandomRelic</kind></li></outcomes></li>
      <li><label>Force the inner door</label><result>The trap fires as the door gives way, but the inner vault holds more.</result><outcomes><li><kind>RandomRelic</kind></li><li><kind>RandomRelic</kind></li><li><kind>InjureRandom</kind><amount>18</amount></li></outcomes></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_Stash</defName>
    <label>buried stash</label>
    <text>Fresh digging marks under a dead tree. Someone hid something here recently.</text>
    <options>
      <li><label>Dig it up</label><result>A sack of silver coins.</result><outcomes><li><kind>Silver</kind><amount>250</amount></li></outcomes></li>
      <li><label>Leave it</label><result>You leave the stash for its owner.</result></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_CargoPod</defName>
    <label>crashed cargo pod</label>
    <text>A cargo pod lies half-buried by the road, its hull still warm.</text>
    <options>
      <li><label>Pry it open</label><result>Inside, packed in foam, you find something useful.</result><outcomes><li><kind>RandomGear</kind></li></outcomes></li>
      <li><label>Leave it</label><result>You move on. Whatever was inside stays there.</result></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_Refugee</defName>
    <label>wounded traveler</label>
    <text>A lone traveler, bleeding and exhausted, asks to join you.</text>
    <options>
      <li><label>Take them in</label><result>The traveler gratefully joins your squad.</result><outcomes><li><kind>Recruit</kind></li></outcomes></li>
      <li><label>Send them on their way</label><result>The traveler limps off down the road.</result></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_Shrine</defName>
    <label>ancient shrine</label>
    <text>An ancient shrine hums with a faint power. Something rests on the altar, guarded by rusted blades.</text>
    <options>
      <li><label>Take the relic</label><result>The blades snap shut as you reach in, but the relic is yours.</result><outcomes><li><kind>RandomRelic</kind></li><li><kind>InjureRandom</kind><amount>12</amount></li></outcomes></li>
      <li><label>Leave it be</label><result>You leave the shrine undisturbed.</result></li>
    </options>
  </Roguelike.RoguelikeEventDef>

  <Roguelike.RoguelikeEventDef>
    <defName>Roguelike_Event_HotSpring</defName>
    <label>hot spring</label>
    <text>Steam rises from a hidden hot spring. It would be a good place to rest.</text>
    <options>
      <li><label>Rest a while</label><result>The warm water soothes every ache.</result><outcomes><li><kind>HealAll</kind></li></outcomes></li>
      <li><label>Search the rocks instead</label><result>Among the rocks you find an old medical cache.</result><outcomes><li><kind>RandomImplant</kind></li></outcomes></li>
    </options>
  </Roguelike.RoguelikeEventDef>

</Defs>
