<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================== Disaster modifiers =====================
    Like other node modifiers, these hold off for the grace period and then escalate with no cap.
    For meteors, tornadoes and the hurricane, offsetPerDay is how many more strikes per day each day.
    For the flood, it is how many cells inland the water advances per day.
  -->

  <GameConditionDef>
    <defName>Roguelike_EscalatingMeteors</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingMeteors</conditionClass>
    <label>meteor storm</label>
    <description>Meteors fall more often and hit harder every day. Watch for their shadows.</description>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>0.1</ratePerDay><graceDays>4</graceDays><weight>0.7</weight></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_EscalatingTornadoes</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingTornadoes</conditionClass>
    <label>tornado season</label>
    <description>Tornadoes touch down more often every day.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>0.05</ratePerDay><graceDays>4</graceDays><weight>0.6</weight><tileTemperature>0~35</tileTemperature></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_EscalatingStorm</defName>
    <conditionClass>Roguelike.GameCondition_EscalatingStorm</conditionClass>
    <label>hurricane</label>
    <description>A hurricane batters the coast. Lightning strikes more often every day.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>0.6</ratePerDay><graceDays>4</graceDays><weight>0.6</weight><coastalOnly>true</coastalOnly><tileTemperature>10~100</tileTemperature></li></modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>Roguelike_RisingFlood</defName>
    <conditionClass>Roguelike.GameCondition_RisingFlood</conditionClass>
    <label>tidal surge</label>
    <description>The sea is rising and pushing inland every day, drowning everything it reaches.</description>
    <allowUnderground>false</allowUnderground>
    <modExtensions><li Class="Roguelike.ModifierExtension"><ratePerDay>2.5</ratePerDay><graceDays>4</graceDays><weight>0.6</weight><coastalOnly>true</coastalOnly></li></modExtensions>
  </GameConditionDef>

  <!-- A vanilla meteor with an aftermath on impact. -->
  <ThingDef ParentName="MeteoriteIncoming">
    <defName>Roguelike_MeteorIncoming</defName>
    <label>meteor (incoming)</label>
    <thingClass>Roguelike.Skyfaller_RoguelikeMeteor</thingClass>
  </ThingDef>

</Defs>
