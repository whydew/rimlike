      <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Gun_Revolver</thingDef></li>
    </parts></scenario>
  </ScenarioDef>

  <!-- Vampire Coven (Sanguophage) -->
  <ScenarioDef ParentName="Roguelike_XenoStarterBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Roguelike_VampireCoven</defName><label>Roguelike: Vampire Coven</label><description>Two sanguophages and their human companion. Signature relic: Hemogen Chalice. Wounds close twice as fast.</description>
    <scenario><summary>Two sanguophages and their human companion.</summary><parts>
      <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes"><def>ConfigurePawnsXenotypes</def><pawnChoiceCount>8</pawnChoiceCount><overrideKinds><li><xenotype>Sanguophage</xenotype><pawnKind>Sanguophage_Player</pawnKind></li></overrideKinds><xenotypeCounts><li><xenotype>Sanguophage</xenotype><count>2</count><requiredAtStart>true</requiredAtStart><allowedDevelopmentalStages>Adult</allowedDevelopmentalStages></li><li><xenotype>Baseliner</xenotype><count>1</count></li></xenotypeCounts></li>
      <li Class="Roguelike.ScenPart_RoguelikeRun"><def>Roguelike_Run</def><starterId>VampireCoven</starterId><requiresUnlock>true</requiresUnlock><starterRelic>Roguelike_Relic_VampireCoven</starterRelic></li>
    </parts></scenario>
  </ScenarioDef>
  <Roguelike.RelicDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Roguelike_Relic_VampireCoven</defName><label>Hemogen Chalice</label><description>Wounds close twice as fast.</description>
    <iconThing>Gold</iconThing><starterOnly>true</starterOnly><hediff>Roguelike_RelicEffect_HemogenChalice</hediff>
  </Roguelike.RelicDef>
  <Roguelike.UnlockDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>Roguelike_Unlock_VampireCoven</defName><label>Vampire Coven starter</label><description>Two sanguophages and their human companion. Relic: Hemogen Chalice.</description><cost>6</cost><starterId>VampireCoven</starterId>
